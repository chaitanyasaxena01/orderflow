NODE_ENV=development
PORT=4000

# PostgreSQL — local, Docker, or Neon
DATABASE_URL=postgresql://orderflow:orderflow@localhost:5432/orderflow?schema=public
# Neon and some hosts require a direct (non-pooled) URL for migrations
DIRECT_URL=postgresql://orderflow:orderflow@localhost:5432/orderflow?schema=public

# Redis — local, Docker, or Upstash (rediss://...)
REDIS_URL=redis://localhost:6379

# JWT secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment webhook HMAC secret
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret-32c

# Optional: Resend email. If empty, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=OrderFlow <onboarding@resend.dev>

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Webhook timestamp tolerance (seconds)
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300
